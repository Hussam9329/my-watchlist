generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model MediaItem {
  id             String   @id @default(cuid())
  title          String
  originalTitle  String?
  year           String
  type           String
  poster         String?
  rating         String?
  overview       String?
  genres         String   @default("")
  episodes       Int?
  seasons        Int?
  duration       String?
  status         String?
  author         String?
  pages          Int?
  tags           String   @default("")
  notes          String   @default("")
  watched        Boolean  @default(false)
  watchedAt      String?
  userRating     Float?
  rewatch        Boolean  @default(false)
  runtime        Int?
  ratingStatus   String   @default("watched")
  addedAt        DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([type])
  @@index([userRating])
  @@index([year])
  @@index([addedAt])
  @@index([title])
  @@index([originalTitle])
  @@index([type, userRating])
  @@index([type, addedAt])
}